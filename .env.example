# Required on Vercel. Create a Neon Postgres database from the project's Storage tab.
# That integration sets POSTGRES_URL. Locally, Folio uses data/folio.db when this is empty.
POSTGRES_URL=

# Required on Vercel. Create a Blob store from the project's Storage tab.
# That integration sets BLOB_READ_WRITE_TOKEN. Locally, PDFs are saved under data/uploads.
BLOB_READ_WRITE_TOKEN=

# Optional. When set, quiz generation and the study assistant use this model.
# Keys are read only on the server and are never sent to the browser.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
